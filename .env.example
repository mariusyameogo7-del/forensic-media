# ==============================================================================
# FORENSIC MEDIA - ENVIRONMENT VARIABLES
# ==============================================================================

# ENVIRONMENT
ENVIRONMENT=development # development | staging | production
DEBUG=true
PROJECT_NAME="Plateforme africaine de vérification numérique"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# FRONTEND URL (CORS)
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# DATABASE (PostgreSQL 17 / Supabase)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/forensic_media"
# In staging/production on Supabase:
# DATABASE_URL="postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres"

# SUPABASE AUTH & STORAGE
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# STORAGE BUCKETS (All private)
STORAGE_BUCKET_ORIGINALS="media-originals"
STORAGE_BUCKET_PREVIEWS="media-previews"
STORAGE_BUCKET_REPORTS="analysis-reports"

# REDIS / CELERY BROKER
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# EXTERNAL ENGINE PROVIDERS
# Hive AI (AI Generation/Manipulation Estimation)
HIVE_API_KEY="your-hive-api-key"
HIVE_API_ENDPOINT="https://api.thehive.ai/api/v2/task/sync"

# Google Cloud Vision (Web Detection)
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
GOOGLE_CLOUD_PROJECT="forensic-media-dev"

# Google Fact Check Tools API
GOOGLE_FACT_CHECK_API_KEY="your-google-fact-check-api-key"

# ANALYSIS SETTINGS
MAX_UPLOAD_SIZE_BYTES=20971520 # 20 MiB
ANONYMOUS_TOKEN_EXPIRY_DAYS=30
DEFAULT_RETAIN_ORIGINAL_FILES=false
DEFAULT_RETAIN_ANALYSIS_HISTORY=true
